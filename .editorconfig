# EditorConfig — https://editorconfig.org
# Indentation uses tabs for all files (3 columns for Rust, 2 columns elsewhere).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
tab_width = 2

[*.rs]
indent_style = tab
tab_width = 3
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
